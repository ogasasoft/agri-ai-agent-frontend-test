# Database connection for Neon PostgreSQL
# Format: postgres://username:password@host:port/database?sslmode=require
# Get your connection string from: https://neon.tech/
DATABASE_URL=postgres://username:password@host:port/database?sslmode=require

# OpenAI API key for chat functionality
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Yamato Transport API credentials
YAMATO_API_KEY=your_yamato_api_key_here
YAMATO_API_SECRET=your_yamato_api_secret_here
YAMATO_API_BASE_URL=https://api.yamato.co.jp/v1

# Base URL for API calls
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Authentication settings
# CSRF secret for token validation (generate with: openssl rand -base64 32)
CSRF_SECRET=your_csrf_secret_here

# Application settings
# Environment: development | staging | production
NODE_ENV=development